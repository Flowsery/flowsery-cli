# Required: API token from https://flowsery.com/api-tokens
# A workspace token (flow_ws_) covers every website, a website key (flow_) covers one
FLOWSERY_API_TOKEN=flow_ws_your-api-token-here

# Also accepted, checked after FLOWSERY_API_TOKEN
# FLOWSERY_API_KEY=flow_ws_your-api-token-here

# Optional: Custom API base URL (defaults to production)
# FLOWSERY_API_URL=https://analytics.flowsery.com/analytics/api/v1

# Optional: credential profile to use instead of the one marked current
# FLOWSERY_PROFILE=default

# Optional: log every request, redacted, to stderr
# FLOWSERY_DEBUG=1

# Optional: force machine mode (JSON on stdout) even on a TTY
# FLOWSERY_JSON=1

# Optional: strip ANSI colour from all output
# NO_COLOR=1
